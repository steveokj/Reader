{
  "manifest_version": 3,
  "name": "Reader Overlay",
  "version": "0.1.0",
  "description": "Reader actions on any webpage.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "options_page": "options.html",
  "action": {
    "default_title": "Reader"
  },
  "commands": {
    "reader:reload": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Reload Reader extension"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["<all_urls>"]
    }
  ]
}

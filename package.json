    "dev:api": ".\\.venv\\Scripts\\python -m uvicorn apps.api.main:app --reload --host 0.0.0.0 --port 8002 --ssl-keyfile 192.168.2.34-key.pem --ssl-certfile 192.168.2.34.pem"
  },
  "devDependencies": {
